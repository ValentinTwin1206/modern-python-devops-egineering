# Copy this file to secrets.toml for local development.
# Never commit secrets.toml or real credentials to source control.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-cookie-secret"
# Expose the access token so the frontend can forward it to the backend API.
expose_tokens = ["id", "access"]

[auth.keycloak]
client_id = "streamlit-frontend"
client_secret = "replace-with-the-keycloak-client-secret"
server_metadata_url = "http://localhost:8081/realms/license-service/.well-known/openid-configuration"
