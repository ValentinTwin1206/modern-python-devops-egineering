FROM continuumio/miniconda3

# Keep Conda and Python output predictable inside the development container.
ENV CONDA_DIR=/opt/conda \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLOUDSMITH_REPOSITORY=""
ENV PATH=$CONDA_DIR/bin:$PATH

WORKDIR /app

# Install native build tools and create the development user 'alice'.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash --groups sudo alice \
    && printf 'alice ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/alice \
    && chmod 0440 /etc/sudoers.d/alice

# Install packaging and publishing tools in Conda "base" environment. 
# The "redsticks" environment is created after the container starts.
RUN conda install \
    -n base \
    -c conda-forge \
    -y conda-build conda-package-handling pip \
    && /opt/conda/bin/python -m pip install --no-cache-dir cloudsmith-cli==1.26.0 \
    && conda clean --all --yes

# Do not activate the base environment automatically.
RUN conda config --system --set auto_activate_base false

# Copy the source, native code, tests, recipe, and sample assets.
COPY environment.yml ./
COPY src ./src
COPY cpp ./cpp
COPY tests ./tests
COPY recipe ./recipe
COPY samples ./samples
COPY README.md ./README.md

ENV PYTHONPATH=/app/src

# Keep the project files and Conda installation writable by the development user.
RUN chown -R alice:alice /app /home/alice /opt/conda

USER alice

# Configure Bash so Conda activation works in the user's interactive shells.
RUN conda init bash

CMD ["/bin/bash"]
