FROM continuumio/miniconda3

# Keep Conda and Python output predictable inside the development container.
ENV CONDA_DIR=/opt/conda \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CLOUDSMITH_REPOSITORY=""
ENV PATH=$CONDA_DIR/bin:$PATH

WORKDIR /app

# Install native build tools and create the development user 'alice'.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash --groups sudo alice \
    && printf 'alice ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/alice \
    && chmod 0440 /etc/sudoers.d/alice

# Install the tools needed to build and inspect Conda packages.
RUN conda install \
    -n base \
    -c conda-forge \
    -y conda-build conda-package-handling \
    && conda clean --all --yes

COPY environment.yml ./

# Create the reproducible project environment before copying source files.
RUN conda env create -f environment.yml && conda clean --all --yes

# Put the RedSticks environment first on PATH for interactive commands.
ENV PATH=$CONDA_DIR/envs/redsticks-demo/bin:$PATH
ENV CONDA_DEFAULT_ENV=redsticks-demo

# Copy the source, native code, tests, recipe, and sample assets.
COPY src ./src
COPY cpp ./cpp
COPY tests ./tests
COPY recipe ./recipe
COPY samples ./samples
COPY README.md ./README.md

ENV PYTHONPATH=/app/src

# Start interactive shells in the project environment and directory.
RUN echo 'source /opt/conda/etc/profile.d/conda.sh' >> /home/alice/.bashrc \
    && echo 'conda activate redsticks-demo' >> /home/alice/.bashrc \
    && echo 'cd /app' >> /home/alice/.bashrc \
    && chown -R alice:alice /app /home/alice /opt/conda

USER alice

CMD ["/bin/bash"]