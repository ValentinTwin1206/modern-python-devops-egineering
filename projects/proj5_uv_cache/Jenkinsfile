pipeline {
    // Run on the demo controller; its Docker image includes uv and Python 3.12.
    agent any

    // Builds share the project directory, so only one should modify .venv at a time.
    options { disableConcurrentBuilds() }
    stages {
        stage('Install from lockfile') {
            steps {
                // Start with a fresh environment while keeping uv's persistent cache.
                dir('/opt/uv-cache-demo') {
                    sh 'rm -rf .venv'
                    // --locked installs the reviewed versions without changing uv.lock.
                    sh 'uv sync --locked --python 3.12'
                }
            }
        }
        stage('Verify dependencies') {
            steps {
                // Check that the ML packages work; no model downloads or GPU needed.
                dir('/opt/uv-cache-demo') {
                    sh '.venv/bin/python -c "import tensorflow, transformers, sklearn; print(\'ML packages imported successfully\')"'
                }
            }
        }
    }
}
