# Development image for exploring uv's cache on Ubuntu 24.04.
FROM ubuntu:24.04

# Match the host user's IDs so bind-mounted project files stay writable.
ARG HOST_UID=1000
ARG HOST_GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates sudo tree \
    && rm -rf /var/lib/apt/lists/*

# Pin uv and uvx to the version used in the cache examples.
COPY --from=ghcr.io/astral-sh/uv:0.11.1 /uv /uvx /usr/local/bin/

RUN existing_user="$(getent passwd "${HOST_UID}" | cut -d: -f1)" \
    && if [ -n "${existing_user}" ]; then userdel "${existing_user}"; fi \
    && group_name="$(getent group "${HOST_GID}" | cut -d: -f1)" \
    && if [ -z "${group_name}" ]; then \
        groupadd --gid "${HOST_GID}" bob; \
        group_name=bob; \
    fi \
    && useradd --uid "${HOST_UID}" --gid "${group_name}" \
        --create-home --shell /bin/bash --groups sudo bob \
    && printf 'bob ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/bob \
    && chmod 0440 /etc/sudoers.d/bob \
    && mkdir -p /app /opt/uv-python \
    && chown -R bob:"${HOST_GID}" /app /opt/uv-python

# Keep installed Python outside the disposable package cache. Copying packages
# into .venv lets the environment continue working after uv cache clean.
ENV UV_CACHE_DIR=/home/bob/.cache/uv \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy \
    HOME=/home/bob \
    USER=bob

WORKDIR /app
USER bob
RUN uv python install 3.12

CMD ["/bin/bash"]
