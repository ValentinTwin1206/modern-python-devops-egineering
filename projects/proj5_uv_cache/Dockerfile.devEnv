# Use the official Jenkins image, which includes Java 21 and Bash.
FROM jenkins/jenkins:lts-jdk21

# build.sh supplies the host user's IDs so files created in /app keep the
# correct ownership on the host.
ARG HOST_UID=1000
ARG HOST_GID=1000

# Pin uv and uvx to the same version for repeatable cache demonstrations.
COPY --from=ghcr.io/astral-sh/uv:0.11.1 /uv /uvx /usr/local/bin/

# Keep the cache in Jenkins home so a volume can preserve it between builds.
# Store Python outside that volume and copy packages into each environment
# instead of linking them across mounts.
ENV UV_CACHE_DIR=/var/jenkins_home/.cache/uv \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy \
    HOME=/home/bob \
    USER=bob

# Install tools as root: sudo lets bob administer this teaching container,
# and tree makes the cache layout easy to inspect.
USER root
RUN test -x /bin/bash \
    && apt-get update \
    && apt-get install -y --no-install-recommends sudo tree \
    && rm -rf /var/lib/apt/lists/*

# Replace any account using the requested UID and reuse a group with the
# requested GID if one exists.
# Give bob passwordless sudo for this demo, plus ownership of the workspace,
# Python installation, and Jenkins data.
RUN existing_user="$(getent passwd "${HOST_UID}" | cut -d: -f1)" \
    && if [ -n "${existing_user}" ]; then userdel "${existing_user}"; fi \
    && group_name="$(getent group "${HOST_GID}" | cut -d: -f1)" \
    && if [ -z "${group_name}" ]; then \
        groupadd --gid "${HOST_GID}" bob; \
        group_name=bob; \
    fi \
    && useradd --uid "${HOST_UID}" --gid "${group_name}" \
        --create-home --shell /bin/bash --groups sudo bob \
    && printf 'bob ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/bob \
    && chmod 0440 /etc/sudoers.d/bob \
    && mkdir -p /app /opt/uv-python /opt/uv-cache-demo \
    && chown -R bob:"${HOST_GID}" \
        /app /opt/uv-python /opt/uv-cache-demo /var/jenkins_home /usr/share/jenkins/ref

# Open development sessions in /app, where build.sh mounts the host project.
WORKDIR /app
COPY --chown=${HOST_UID}:${HOST_GID} pyproject.toml uv.lock ./
# Keep a separate project copy for Jenkins builds without a development mount.
COPY --chown=${HOST_UID}:${HOST_GID} pyproject.toml uv.lock /opt/uv-cache-demo/
# Enable one Jenkins executor so the pipeline can run on this demo controller.
COPY --chown=${HOST_UID}:${HOST_GID} init.groovy /usr/share/jenkins/ref/init.groovy.d/uv-cache-demo.groovy

# Install Python as bob, but leave project dependencies for the cache workflow.
USER bob
RUN uv python install 3.12

# Open Bash by default; pass /usr/local/bin/jenkins.sh to start Jenkins instead.
CMD ["/bin/bash"]
