# DEVELOPMENT IMAGE:
#   - uses ubuntu:24.04 and its APT-managed Python 3.12
#   - installs the Debian build toolchain used for the local .deb workflow
#   - includes AR and dpkg inspection tools used to inspect generated .deb artifacts
#   - installs the APT-managed `python3-systemd` binding used by simply_journal_admin
#   - installs the Cloudsmith CLI used to publish generated package artifacts
#   - opens an interactive shell for inspection and packaging work
#
# DISCLAIMER:
#   This image intentionally mixes Python package installation levels: some
#   tools are installed through APT, some through system-level `pip`, and some
#   through a user-level `pip --user` install. That is a weak environment
#   design for real projects, and it is used here only to demonstrate that the
#   required tools can all be made available in one container for project
#   management tasks. For production-quality development workflows, prefer a
#   dedicated virtual environment so Python dependencies remain isolated and
#   predictable.
# # # # # # # # # # #
FROM ubuntu:24.04

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/home/bob/.local/bin:$PATH"
ENV PYTHONPATH=/app/src
ENV CLOUDSMITH_REPOSITORY=""

ARG HOST_UID=1000
ARG HOST_GID=1000

#
# Configure the project workspace.
#
WORKDIR /app

#
# Install Ubuntu's Python packages, Debian packaging tools, and inspection
# helpers. python3-systemd is the APT-only binding used by the project.
#
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        binutils \
        ca-certificates \
        curl \
        debhelper \
        devscripts \
        gnupg \
        python3 \
        python3-pip \
        python3-systemd \
        sudo \
        tree \
    && rm -rf /var/lib/apt/lists/*

#
# Create bob with the host user's numeric UID/GID so files written through the
# bind mounts remain owned by the host user.
#
RUN existing_user="$(getent passwd "${HOST_UID}" | cut -d: -f1)" \
    && if [ -n "${existing_user}" ] && [ "${existing_user}" != bob ]; then \
        userdel "${existing_user}"; \
    fi \
    && group_name="$(getent group "${HOST_GID}" | cut -d: -f1)" \
    && if [ -z "${group_name}" ]; then \
        groupadd --gid "${HOST_GID}" bob; \
        group_name=bob; \
    fi \
    && useradd --uid "${HOST_UID}" --gid "${group_name}" \
        --create-home --shell /bin/bash --groups sudo bob \
    && printf 'bob ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/bob \
    && chmod 0440 /etc/sudoers.d/bob

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

#
# Install administrator-level tools before switching to bob.
#
RUN uv pip install --system --break-system-packages cloudsmith-cli ruff

#
# Ensure the workspace and bob's home are writable by bob before USER takes effect.
#
RUN group_name="$(getent group "${HOST_GID}" | cut -d: -f1)" \
    && chown -R bob:"${group_name}" /app /home/bob

# Project files are expected to be bind-mounted into /app at runtime.
USER bob

# Install one developer CLI tool into bob's user-local target.
RUN python3 -m pip install karva --user --break-system-packages

ENTRYPOINT ["/bin/bash"]
