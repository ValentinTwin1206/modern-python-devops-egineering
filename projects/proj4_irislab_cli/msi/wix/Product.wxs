<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="IrisLab CLI"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Modern Python Engineering"
           UpgradeCode="A3DF70A0-09AF-4170-830A-9998717F8211">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="IrisLab CLI $(var.ProductVersion) installer"
             Manufacturer="Modern Python Engineering" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ValentinTwin1206/modern-python-devops-egineering" />

    <Feature Id="MainFeature" Title="IrisLab CLI" Level="1">
      <ComponentRef Id="IrisLabCliExecutable" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="IrisLabCLI">
          <Component Id="IrisLabCliExecutable" Guid="B02FCC1B-95D6-4D66-8FD8-9CA04FB264E4">
            <File Id="IrisLabCliExe"
                  Source="$(var.IrisLabCliExecutable)"
                  Name="irislab-cli.exe"
                  KeyPath="yes" />
            <Environment Id="UpdatePath"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Permanent="no"
                         Part="last"
                         Action="set"
                         System="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
  </Product>
</Wix>
